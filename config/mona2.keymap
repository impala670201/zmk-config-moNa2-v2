#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 5
#define SCROLL 6

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <300>;
    flavor = "balanced";
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        scroll_up_down: mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        scroll_right_left: mouse_wheel_right_left {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp Q      &kp W         &kp E     &kp R                &kp T                                     &kp Y      &kp U  &kp I      &kp O    &kp P
&kp A      &kp S         &kp D     &kp F                &kp G                      &kp MINUS      &kp H      &kp J  &kp K      &kp L    &kp ENTER
&kp Z      &kp X         &kp C     &kp V                &kp B       &kp UNDER      &kp SEMICOLON  &kp N      &kp M  &kp COMMA  &kp DOT  &kp LS(QUESTION)
&kp LCTRL  &kp LEFT_WIN  &kp LALT  &lt 2 RIGHT_BRACKET  &lt 5 BSLH  &lt 3 MINUS    &lt 1 SPACE    &kp SPACE                             &kp RSHFT
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_1 {
            bindings = <
&kp KP_NUMLOCK     &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp UNDER                    &kp SEMI    &kp LBKT  &trans  &trans  &kp BSPC
&kp DOUBLE_QUOTES  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp COLON            &trans  &kp APOS    &trans    &trans  &trans  &kp LA(TILDE)
&kp FSLH           &kp KP_N1        &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp MINUS  &trans    &trans  &kp LC(N1)  &trans    &trans  &trans  &kp PIPE
&kp LSHFT          &kp KP_NUMBER_0  &kp PERIOD       &trans           &trans     &trans    &trans  &trans                                &kp RSHFT
            >;

            sensor-bindings = <&scroll_right_left>;
        };

        layer_2 {
            bindings = <
&kp ESC    &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)                                 &kp PAGE_UP    &trans    &kp LS(RIGHT_GUI)  &trans     &kp DELETE
&kp TAB    &kp LS(N5)        &kp LS(NUMBER_6)  &kp LS(N7)        &kp LS(N7)                             &kp HOME  &kp PAGE_DOWN  &trans    &kp UP_ARROW       &trans     &kp LANGUAGE_2
&kp LSHFT  &kp LS(N8)        &kp LS(N9)        &kp LS(N0)        &kp PLUS          &kp LS(BACKSLASH)    &kp END   &kp SEMI       &kp LEFT  &kp DOWN           &kp RIGHT  &trans
&kp LSHFT  &trans            &kp LALT          &trans            &trans            &trans               &trans    &trans                                                 &kp RSHFT
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        layer_3 {
            bindings = <
&kp F1     &kp F2   &kp F3    &kp F4   &trans                                     &kp MINUS  &kp EQUAL  &kp LBKT   &kp RBKT   &kp BSLH
&kp F5     &kp F6   &kp F7    &kp F8   &kp LC(LG(RIGHT_ARROW))            &trans  &kp SEMI   &kp APOS   &kp ENTER  &kp COMMA  &kp DOT
&kp F9     &kp F10  &kp F11   &kp F12  &trans                   &trans    &trans  &kp FSLH   &kp GRAVE  &trans     &trans     &trans
&kp LCTRL  &trans   &kp LALT  &trans   &trans                   &trans    &trans  &trans                                      &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        layer_4 {
            bindings = <
&trans     &trans  &trans    &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans     &trans  &trans    &trans  &trans            &trans       &trans        &mkp MB1      &mkp MB3      &mkp MB2      &trans
&trans     &trans  &trans    &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&kp LCTRL  &trans  &kp LALT  &trans  &trans  &trans    &trans       &trans                                                  &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        MOUSE {
            bindings = <
&kp ESC    &trans  &trans    &trans  &trans                    &trans  &trans    &mkp MB4  &trans    &kp BSPC
&kp TAB    &trans  &trans    &trans  &trans            &trans  &trans  &mkp MB1  &trans    &mkp MB2  &kp GRAVE
&kp LSHFT  &trans  &trans    &trans  &trans  &trans    &trans  &trans  &trans    &mkp MB5  &trans    &kp FSLH
&kp LCTRL  &trans  &kp LALT  &trans  &trans  &trans    &trans  &trans                                &kp RSHFT
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};
